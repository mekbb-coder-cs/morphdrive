# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://morphdrive:morphdrive_secret@localhost:5432/morphdrive?schema=public

# Security & JWT
JWT_ACCESS_SECRET=super_secret_morphdrive_access_token_key_change_me_in_prod
JWT_REFRESH_SECRET=super_secret_morphdrive_refresh_token_key_change_me_in_prod

# Cloudflare R2 / AWS S3 Asset Storage
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET_NAME=morphdrive-assets
S3_PUBLIC_CDN_URL=https://assets.morphdrive.io

# Logging
LOG_LEVEL=info
